---
import Logotype from './Logotype.astro';

const EMAIL = 'ryan@ryfabmotorsports.com';
---
<footer class="site-footer ryfab-inverse">
  <div class="rule-accent"></div>
  <div class="container site-footer__grid">
    <div class="site-footer__about">
      <Logotype size={22} light />
    </div>
    <div class="site-footer__col">
      <span class="eyebrow">Contact</span>
      <a href={`mailto:${EMAIL}`} class="site-footer__link">{EMAIL}</a>
      <a
        href="https://instagram.com/ryfabmotorsports"
        class="site-footer__social"
        aria-label="RyFab Motorsports on Instagram"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
        <span>@ryfabmotorsports</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--gray-950); color: var(--gray-0); }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-8);
    padding: 48px var(--gutter);
  }
  .site-footer__about { display: flex; flex-direction: column; gap: var(--space-4); }
  .site-footer__col { display: flex; flex-direction: column; gap: 10px; }
  .site-footer__link {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    color: var(--gray-300);
  }
  .site-footer__link:hover { color: var(--text-link-hover); }
  .site-footer__social {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--gray-400);
    transition: var(--transition-control);
  }
  .site-footer__social svg { display: block; flex-shrink: 0; }
  .site-footer__social span {
    font-family: var(--font-text);
    font-size: var(--text-sm);
    line-height: 1;
  }

  .site-footer__social:hover { color: var(--accent); }

  @media (max-width: 720px) {
    .site-footer__grid { grid-template-columns: 1fr; }
  }
</style>
