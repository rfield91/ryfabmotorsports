---
import Logotype from './Logotype.astro';

const NAV = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Products', href: '/products/' },
  { label: 'About', href: '/about/' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container site-header__row">
    <a href="/" class="site-header__brand" aria-label="RyFab Motorsports — home">
      <Logotype size={22} />
    </a>
    <div class="site-header__bottom">
      <nav class="site-header__nav" aria-label="Primary">
        {NAV.map((item) => (
          <a href={item.href} class="site-header__link" aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="site-header__actions">
        <a href="/contact/" class="btn btn--primary btn--sm">Contact</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--gray-0);
    border-bottom: 1px solid var(--border-subtle);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: 72px;
  }
  .site-header__brand { display: inline-flex; }
  .site-header__bottom { display: contents; }
  .site-header__nav {
    display: flex;
    gap: 26px;
    margin-left: auto;
  }
  .site-header__link {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    height: 32px;
    line-height: 1;
  }
  .site-header__link:hover { color: var(--text-primary); }
  .site-header__link[aria-current='page'] {
    color: var(--text-primary);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  @media (max-width: 720px) {
    .site-header__row {
      flex-wrap: wrap;
      height: auto;
      padding: var(--space-3) var(--gutter);
      gap: var(--space-3);
    }
    .site-header__bottom {
      display: flex;
      align-items: center;
      width: 100%;
    }
    .site-header__nav { margin-left: 0; gap: 14px; }
    .site-header__link { font-size: 13px; }
    .site-header__actions { margin-left: auto; }
  }

  @media (max-width: 380px) {
    .site-header__nav { gap: 10px; }
    .site-header__link { font-size: 12px; letter-spacing: 0.08em; }
  }
</style>
