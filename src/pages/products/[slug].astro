---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const FULL_WIDTH = 1600;

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => !data.draft);
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const { name, summary, variants, cover, coverAlt, gallery } = product.data;

const coverFull = cover ? await getImage({ src: cover, width: FULL_WIDTH }) : null;
const galleryFull = await Promise.all(gallery.map((g) => getImage({ src: g.image, width: FULL_WIDTH })));

const hasMultipleVariants = variants.length > 1;

const pageURL = new URL(Astro.url.pathname, Astro.site).href;
const toNumericPrice = (price: string) => price.replace(/[^0-9.]/g, '');
const prices = variants.map((v) => Number(toNumericPrice(v.price)));

const productJsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name,
  description: summary,
  brand: { '@type': 'Brand', name: 'RyFab Motorsports' },
  ...(coverFull ? { image: [new URL(coverFull.src, Astro.site).href] } : {}),
  offers: hasMultipleVariants
    ? {
        '@type': 'AggregateOffer',
        priceCurrency: 'USD',
        lowPrice: Math.min(...prices).toFixed(2),
        highPrice: Math.max(...prices).toFixed(2),
        offerCount: variants.length,
        url: pageURL,
      }
    : {
        '@type': 'Offer',
        priceCurrency: 'USD',
        price: prices[0].toFixed(2),
        availability: 'https://schema.org/InStock',
        url: pageURL,
      },
};
---
<BaseLayout title={name} description={summary} image={coverFull?.src}>
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <main>
    <section class="section section--tight">
      <div class="container product-head">
        <a href="/products/" class="back-link">&larr; All products</a>
        <div class="section-head">
          <h1>{name}</h1>
          <p class="lead">{summary}</p>
        </div>
        <div class="product-buy">
          {hasMultipleVariants ? (
            <span class="select-wrap">
              <select id="variant-select" class="input" aria-label="Configuration" data-variants={JSON.stringify(variants)}>
                {variants.map((v, i) => (
                  <option value={i}>{v.label} — {v.price}</option>
                ))}
              </select>
            </span>
          ) : (
            <span class="product-buy__single">
              <span class="product-buy__label">{variants[0].label}</span>
              <span class="mono product-buy__price">{variants[0].price}</span>
            </span>
          )}
          <a href={variants[0].stripeLink} class="btn btn--primary" id="buy-link">Buy now</a>
        </div>
        <p class="product-disclaimer">By purchasing, you agree to our <a href="/disclaimer/">disclaimer</a>.</p>
      </div>
    </section>

    <section class="section section--tight" style="padding-top: 0;">
      <div class="container product-body">
        {cover && coverFull ? (
          <a href={coverFull.src} target="_blank" rel="noopener noreferrer" aria-label={`View full-size photo: ${coverAlt}`}>
            <Image src={cover} alt={coverAlt} class="product-cover" widths={[400, 700, 1120]} sizes="(max-width: 1120px) 100vw, 1120px" />
          </a>
        ) : (
          <div class="placeholder placeholder--16-9">
            <span>{coverAlt}</span>
          </div>
        )}
        <article class="prose">
          <Content />
        </article>
        {gallery.length > 0 && (
          <div class="gallery">
            {gallery.map((g, i) => (
              <a href={galleryFull[i].src} target="_blank" rel="noopener noreferrer" aria-label={`View full-size photo: ${g.alt}`}>
                <Image src={g.image} alt={g.alt} class="gallery__photo" widths={[300, 500]} sizes="(max-width: 640px) 50vw, 33vw" />
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    {hasMultipleVariants && (
      <script>
        const select = document.getElementById('variant-select') as HTMLSelectElement | null;
        const buyLink = document.getElementById('buy-link') as HTMLAnchorElement | null;
        if (select && buyLink) {
          const variants = JSON.parse(select.dataset.variants || '[]') as {
            label: string;
            price: string;
            stripeLink: string;
          }[];
          select.addEventListener('change', () => {
            const v = variants[Number(select.value)];
            if (v) buyLink.href = v.stripeLink;
          });
        }
      </script>
    )}
  </main>
</BaseLayout>

<style>
  .product-head { display: flex; flex-direction: column; gap: var(--space-5); }
  .back-link {
    font-family: var(--font-display);
    font-size: var(--label-size);
    font-weight: 600;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .back-link:hover { color: var(--text-primary); }

  .product-buy { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .product-buy .select-wrap { min-width: 280px; }
  .product-buy__single { display: flex; align-items: center; gap: var(--space-3); }
  .product-buy__label { font-family: var(--font-text); font-size: var(--text-md); color: var(--text-primary); }
  .product-buy__price { font-size: var(--text-lg); color: var(--text-primary); }
  .product-disclaimer { font-family: var(--font-text); font-size: var(--text-xs); color: var(--text-muted); }

  .product-body { display: flex; flex-direction: column; gap: var(--space-8); }
  .product-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .gallery a { cursor: zoom-in; }
  .gallery__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .gallery { grid-template-columns: repeat(2, 1fr); }
  }
</style>
