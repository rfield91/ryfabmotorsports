---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import heroPhoto from '../content/photos/hero.jpg';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const recent = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 4);

const SERVICES = [
  { name: 'Fabrication', copy: 'From custom exhaust, to roll bars, or pretty much anything you can think of.' },
  { name: 'Wiring', copy: 'Aftermarket ECU installation, harness modifications, to completely bespoke chassis harnesses.' },
  { name: 'Setup', copy: 'Performance part installation to corner balancing and alignment.' },
  { name: 'Weird idea?', copy: "Everything that doesn't fit in a box. Send me the problem and we'll figure it out." },
];
---
<BaseLayout title="Home">
  <main>
    <section class="hero ryfab-inverse">
      <Image
        src={heroPhoto}
        alt="RX8 exiting a corner on track"
        class="hero__photo"
        widths={[800, 1200, 1600, 2000]}
        sizes="100vw"
        loading="eager"
      />
      <div class="hero__scrim"></div>
      <div class="container hero__row">
        <h1 class="visually-hidden">RyFab Motorsports</h1>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--primary btn--lg">Contact me</a>
          <a href="/projects/" class="btn btn--outline btn--lg btn--on-dark">See my projects</a>
        </div>
      </div>
      <div class="rule-accent"></div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Services</h2>
        </div>
        <div class="grid grid--4" style="margin-top: var(--space-10);">
          {SERVICES.map((s) => (
            <div class="card">
              <div class="card__body">
                <h3 class="card__title">{s.name}</h3>
                <p class="card__text">{s.copy}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="recent-head">
          <div class="section-head">
            <h2>Projects</h2>
          </div>
          <a href="/projects/" class="btn btn--ghost">View all projects</a>
        </div>
        <div class="grid grid--4" style="margin-top: var(--space-8);">
          {recent.map((p) => (
            <a href={`/projects/${p.id}/`} class="card card--interactive project-card">
              {p.data.cover ? (
                <Image src={p.data.cover} alt={p.data.coverAlt} class="card__photo" widths={[300, 500]} sizes="(max-width: 860px) 100vw, 25vw" />
              ) : (
                <div class="placeholder placeholder--4-3 card__media">
                  <span>{p.data.coverAlt}</span>
                </div>
              )}
              <div class="card__body">
                <span class="card__eyebrow">{p.data.tags.join(' · ')}</span>
                <h3 class="card__title">{p.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section--accent cta-band">
      <div class="container cta-band__row">
        <div>
          <h2 class="cta-band__title">Ready to start a project?</h2>
        </div>
        <a href="/contact/" class="btn btn--solid btn--lg">Get in touch</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(420px, 70vh, 680px);
    background: var(--gray-950);
    color: var(--gray-0);
    overflow: hidden;
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.65) 0%, rgb(0 0 0 / 0) 55%);
  }
  .hero .rule-accent { position: absolute; left: 0; right: 0; bottom: 0; }
  .hero .btn--outline { border-color: var(--gray-0); background: rgb(0 0 0 / 0.35); }
  .hero .btn--outline:hover { background: rgb(0 0 0 / 0.6); }
  .hero__row {
    position: relative;
    width: 100%;
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
  }
  .hero__actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Two plain .section blocks in a row (Services, Projects) would otherwise
     each add --section-y padding, doubling the gap between them. */
  .section + .section { padding-top: 0; }

  .recent-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap; }
  .project-card { color: inherit; }
  .project-card:hover { color: inherit; }
  .card__photo { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; }

  .cta-band { padding: 56px 0; }
  .cta-band__row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); flex-wrap: wrap; }
  .cta-band__title {
    font-family: var(--font-display);
    font-size: var(--display-3);
    line-height: 1;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--gray-950);
  }

</style>
