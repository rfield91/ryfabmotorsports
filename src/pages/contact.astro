---
import BaseLayout from '../layouts/BaseLayout.astro';

const EMAIL = 'ryan@ryfabmotorsports.com';
// Set FORMSPREE_ENDPOINT in .env (local) or the host's environment variables
// (per-environment in production). Falls back to the testing form so the
// site still builds and works without any env var configured.
// See README.md "Contact form".
const FORMSPREE_ENDPOINT = import.meta.env.FORMSPREE_ENDPOINT || 'https://formspree.io/f/xeaqrepr';
---
<BaseLayout title="Contact" description="Get in touch with RyFab Motorsports — tell me about your car and what you need.">
  <main>
    <section class="section section--tight">
      <div class="container">
        <div class="contact-form-col">
          <div class="section-head">
            <h1>Contact</h1>
            <p class="lead">Tell me about your car and what you're trying to get done. Fill out the form, or email me directly at <a href={`mailto:${EMAIL}`}>{EMAIL}</a>. I'll reply as soon as I can.</p>
          </div>

          <form id="contact-form" method="POST" action={FORMSPREE_ENDPOINT} class="contact-form">
            <input type="hidden" name="_subject" value="New message from ryfabmotorsports.com" />
            <p class="hp-field"><label>Don't fill this out if you're human: <input name="_gotcha" /></label></p>

            <div class="field">
              <label for="c-name">Name<span class="required">*</span></label>
              <input class="input" id="c-name" name="name" placeholder="First and last" required />
            </div>

            <div class="field">
              <label for="c-email">Email<span class="required">*</span></label>
              <input class="input" id="c-email" name="email" type="email" placeholder="you@example.com" required />
            </div>

            <div class="field">
              <label for="c-notes">What do you need help with?</label>
              <textarea class="input" id="c-notes" name="notes" rows="5" placeholder="Tell me about your car and what you need"></textarea>
            </div>

            <p class="contact-form__error" hidden>
              Something went wrong sending that. Try again, or email me directly at <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
            </p>

            <div class="contact-submit">
              <button type="submit" class="btn btn--primary btn--lg">Submit</button>            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const errorEl = form?.querySelector('.contact-form__error');
    const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorEl?.setAttribute('hidden', '');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (response.ok) {
          window.location.href = '/contact/success/';
          return;
        }
      } catch {
        // fall through to error state below
      }
      errorEl?.removeAttribute('hidden');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit';
      }
    });
  </script>
</BaseLayout>

<style>
  .contact-form-col { display: flex; flex-direction: column; gap: var(--space-6); max-width: 720px; }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .hp-field { position: absolute; left: -9999px; }
  .contact-form__error {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--status-danger-bg);
    color: var(--status-danger-fg);
    font-family: var(--font-text);
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
  }
  .contact-form__error a { color: inherit; text-decoration: underline; }

  .contact-submit { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .section-head .lead a { color: var(--text-primary); text-decoration: underline; }
</style>
